// Learning Tracker — data model
// Hierarchy: Course -> Topic -> Quiz -> Question -> QuestionOption
// Material hangs off Topic. Candidates are granted access per Topic.
//
// Staff come in two kinds, and an account is one or the other:
//
//   lead     Runs courses. A course's owner is always a lead: they edit it,
//            create topics, hand each one to a trainer, and are the only ones
//            who can publish anything to candidates.
//   trainer  Works under leads. Added to a course's team by an admin, writes
//            the material and quiz for the topics handed to them, and can
//            never publish or own a course.
//   admin    Everything, everywhere.
//
// Authority is still checked per course — leading one course grants nothing on
// another — but only a `lead` account can ever be a course's owner, and only a
// `trainer` account can sit on a team.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums

enum Role {
  candidate // employee attending courses
  trainer // writes the topics a lead hands them; may never publish
  lead // runs courses: publishes them and divides the work among trainers
  admin // super admin; sees every course and everyone on it
}

enum MaterialType {
  rich_text // authored in-app, stored in Material.body
  pdf // uploaded PDF, viewable inline; stored at Material.fileUrl
  slides // uploaded pptx/odp, download-only; stored at Material.fileUrl
  link // external URL, stored at Material.fileUrl
}

enum QuestionType {
  mcq_single // exactly one correct option
  mcq_multi // two or more correct options
  written // not built yet; kept here so adding it is an insert, not a migration
}

enum EnrollmentStatus {
  pending // candidate asked to join; awaiting a trainer's decision
  active // approved, or created directly by a trainer allotting a topic
}

/**
 * A one-to-one request's life: asked for, given a time, or turned down.
 * There is no "finished" — a session that has happened is simply one whose
 * time is in the past, and asking the lead to close it afterwards would be
 * asking for admin nobody would do.
 */
/** An extension request's life. Mirrors SessionStatus; different decision. */
/**
 * Why somebody was told something. The kind drives the wording and the action
 * offered, so a new reason to notify means a new member here rather than free
 * text nobody can branch on.
 */
enum NoticeKind {
  new_version // a later edition of a course they are on has been published
}

/** A request to leave a course: asked for, granted, or refused. */
enum DiscontinueStatus {
  requested
  approved
  declined
}

enum ExtensionStatus {
  requested
  approved
  declined
}

enum SessionStatus {
  requested // candidate has asked; waiting on the lead
  scheduled // lead has given it a time
  declined  // lead said no, with a reason
}

enum AttemptStatus {
  in_progress
  submitted
  scored
}

enum AnswerStatus {
  submitted // auto-scored MCQ, final
  pending_review // written answer awaiting a trainer
  reviewed // written answer graded by a trainer
}

// ---------------------------------------------------------------- people

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(candidate)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Courses this user leads. Named "owned" for history; `lead` is the word used
  // everywhere the concept is talked about.
  coursesOwned     Course[]           @relation("CourseOwner")
  courseTeams      CourseTrainer[]    @relation("TrainerOnCourse")
  materialsAdded   Material[]         @relation("MaterialUploader")
  materialDuties   Topic[]            @relation("TopicMaterialDuty")
  quizDuties       Topic[]            @relation("TopicQuizDuty")
  enrollments      Enrollment[]
  topicAccess      TopicAssignment[]  @relation("AssignedCandidate")
  topicsGranted    TopicAssignment[]  @relation("GrantedByTrainer")
  // The discipline this person is being trained in — MERN, Python, Project
  // Management. Candidates only in practice, and optional: an account exists
  // before anyone has decided where it belongs.
  //
  // NOT the same thing as Course.team, which is a course's trainers. That one
  // is about who teaches a course; this one is about what a candidate is being
  // trained as, and the two never meet.
  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  projectWork      ProjectAllotment[] @relation("ProjectCandidate")
  projectsAllotted ProjectAllotment[] @relation("ProjectAllottedBy")
  projectsMarked   ProjectAllotment[] @relation("ProjectEvaluatedBy")
  notifications     Notification[]     @relation("NotifiedUser")
  discontinuesAsked   DiscontinuationRequest[] @relation("DiscontinueCandidate")
  discontinuesDecided DiscontinuationRequest[] @relation("DiscontinueDecidedBy")
  extensionsAsked   ExtensionRequest[] @relation("ExtensionCandidate")
  extensionsDecided ExtensionRequest[] @relation("ExtensionDecidedBy")
  sessionsAsked    SessionRequest[]   @relation("SessionCandidate")
  sessionsDecided  SessionRequest[]   @relation("SessionDecidedBy")
  attempts         Attempt[]
  feedback         CourseFeedback[]

  @@index([role])
  @@index([teamId])
  @@map("users")
}

// ---------------------------------------------------------------- content

model Course {
  id            String   @id @default(uuid())
  /**
   * The subject, and which edition of it.
   *
   * A course is versioned by copying it: PM-101 v2 is a separate row from
   * PM-101 v1, with its own topics, its own candidates and its own results.
   * That is what lets a cohort finish the edition they started while the next
   * one is being taught alongside — which a single row with a version counter
   * cannot do, because there is only one set of topics to go round.
   *
   * So `code` is no longer unique on its own; the pair is.
   */
  code          String
  version       Int      @default(1)
  title         String
  description   String?
  // How long the course is expected to take, in weeks. Optional — used to show
  // candidates what they are committing to, and to flag those running over.
  durationWeeks Int?
  isPublished   Boolean  @default(false)
  // Null until an admin allots the course to a trainer. Admins create courses
  // as a code and a title; who runs it is a separate decision, made later on
  // the allotment screen.
  ownerId       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // What the course is about. Optional, and stays optional: a course is created
  // as a code and a title before anyone has decided where it belongs, and an
  // unfiled course must still be a usable course.
  categoryId String?

  owner       User?            @relation("CourseOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  team        CourseTrainer[]
  topics      Topic[]
  projects    Project[]
  enrollments Enrollment[]
  feedback    CourseFeedback[]
  sessions    SessionRequest[]
  extensions  ExtensionRequest[]
  discontinues DiscontinuationRequest[]
  notices     Notification[]

  @@unique([code, version])
  @@index([ownerId])
  @@index([categoryId])
  @@map("courses")
}

/**
 * What a course is about: Frontend, Backend, UI/UX, Project Management.
 * A table rather than an enum because this list belongs to the organisation,
 * not to the software — a new discipline should be an administrator typing a
 * name, not a migration and a deploy.
 * Deleting one is deliberately survivable: the courses in it fall back to
 * uncategorised (onDelete: SetNull) rather than going with it. Getting the
 * grouping wrong should never be a way to lose a course.
 */
/**
 * A candidate's team: the discipline they are being trained in — MERN, Python,
 * Project Management.
 *
 * Shaped exactly like Category, and for the same reason: the list belongs to
 * the organisation rather than the software, so adding one is an administrator
 * typing a name. Category groups courses by subject; Team groups people by
 * what they are being trained as. A candidate on the MERN team may well sit a
 * Project Management course.
 *
 * Removing a team leaves its members in place, unassigned (onDelete: SetNull) —
 * reorganising must never be a way to lose people.
 */
model Team {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique
  // Display order wherever people are grouped, so the grouping reads the same
  // everywhere instead of falling out of an alphabetical accident.
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members User[]

  @@map("teams")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  // Stable identifier for a category whose name may be edited later.
  slug      String   @unique
  // Order across every grouped list. Explicit, so the grouping reads the same
  // on the catalogue, the browse page and a lead's own list, instead of falling
  // out of whatever alphabetical accident the names produce.
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses Course[]

  @@map("categories")
}

/**
 * A trainer on a course's team, put there by an admin.
 * The team is who the lead may hand topics to. Being on it grants no authority
 * over the course itself — a team trainer builds what they are given and cannot
 * publish it. The lead is NOT a row here; they are Course.ownerId.
 */
model CourseTrainer {
  id       String   @id @default(uuid())
  courseId String
  userId   String
  addedAt  DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation("TrainerOnCourse", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([userId])
  @@map("course_trainers")
}

model Topic {
  id                String   @id @default(uuid())
  courseId          String
  position          Int // display order in the left-hand sidebar
  title             String
  description       String?
  // Only the course's lead may set this. A team trainer writes the material and
  // the quiz; releasing it to candidates is the lead's decision.
  isPublished       Boolean  @default(false)
  // A topic is two pieces of work, and the lead may hand them to different
  // people: one writes the reading material, another sets the quiz. Either is
  // null while that half has not been handed out.
  materialTrainerId String?
  quizTrainerId     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  course          Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  materialTrainer User?             @relation("TopicMaterialDuty", fields: [materialTrainerId], references: [id], onDelete: SetNull)
  quizTrainer     User?             @relation("TopicQuizDuty", fields: [quizTrainerId], references: [id], onDelete: SetNull)
  materials       Material[]
  quiz            Quiz?
  assignments     TopicAssignment[]

  @@unique([courseId, position])
  @@index([courseId])
  @@index([materialTrainerId])
  @@index([quizTrainerId])
  @@map("topics")
}

/**
 * A piece of practical work set on a course — "draft a project charter" — as
 * opposed to a topic, which is something to read and be tested on.
 * The course's lead writes these. Handing them to candidates is the admin's
 * decision, which is why there is no duty column here: a project is not written
 * by a trainer, it is set once and given out.
 */
model Project {
  id        String    @id @default(uuid())
  courseId  String
  position  Int // display order within the course
  title     String
  brief     String?
  // Optional deadline, shown to the candidate and used to flag overdue work.
  dueAt     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  course     Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  allotments ProjectAllotment[]

  @@unique([courseId, position])
  @@index([courseId])
  @@map("projects")
}

/**
 * One candidate's copy of a project. The same project goes to as many people as
 * the admin likes; each of them finishes it in their own time, so the done mark
 * lives here rather than on the project.
 */
model ProjectAllotment {
  id          String    @id @default(uuid())
  projectId   String
  userId      String
  allottedBy  String
  allottedAt  DateTime  @default(now())
  // Set when the candidate marks it finished, cleared if they undo that.
  completedAt DateTime?

  // What they handed in. A link, a file, or both — a coding project is a repo,
  // a written one is a document. Kept beside completedAt rather than replacing
  // it: a project can be finished without producing an artefact to attach.
  submissionUrl    String?
  submissionNote   String?
  fileUrl          String? // storage key, as Material.fileUrl
  originalFilename String?
  mimeType         String?
  fileSizeBytes    BigInt?
  submittedAt      DateTime?

  // The lead's judgement of that work. Deliberately apart from completedAt:
  // finishing is the candidate's claim about their own work, evaluating is the
  // lead's answer to it, and the two happen days apart. Either half stands on
  // its own — a score with no comment, or a comment with no score.
  score       Int? // out of 100
  feedback    String?
  evaluatedBy String?
  evaluatedAt DateTime?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation("ProjectCandidate", fields: [userId], references: [id], onDelete: Cascade)
  admin     User    @relation("ProjectAllottedBy", fields: [allottedBy], references: [id], onDelete: Restrict)
  // SetNull rather than Restrict: a lead can leave, and their marks outlive
  // them even when the name behind them is gone.
  evaluator User?   @relation("ProjectEvaluatedBy", fields: [evaluatedBy], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_allotments")
}

model Material {
  id               String       @id @default(uuid())
  topicId          String
  type             MaterialType
  title            String
  body             String? // rich_text only: HTML/JSON authored in-app
  // pdf / slides: object-storage key (bucket path), resolved to a signed URL
  // at read time. link: the external URL itself.
  fileUrl          String?
  // File metadata — populated for uploaded pdf/slides, null otherwise.
  originalFilename String?
  mimeType         String?
  fileSizeBytes    BigInt?
  position         Int
  // Who put it there. Nullable because material that predates this column has
  // no answer, and inventing one would be worse than admitting it — and
  // SetNull rather than Restrict, so the record of the file outlives the
  // account of whoever uploaded it.
  uploadedById     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  topic      Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("MaterialUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([topicId, position])
  @@index([topicId])
  @@map("materials")
}

// ---------------------------------------------------------------- assessment

model Quiz {
  id             String   @id @default(uuid())
  topicId        String   @unique // one quiz per topic
  title          String
  maxAttempts    Int? // null = unlimited retakes
  // How many questions one sitting draws from the bank. Null serves every
  // question there is, which is what every quiz written before this did and
  // what a small quiz should go on doing.
  //
  // The questions themselves are the bank: a quiz with 50 questions and this
  // set to 12 gives each candidate a different twelve, which is the half of
  // anti-cheating that shuffling alone cannot provide.
  questionsPerAttempt Int?
  // The organisation's standard is 60%; a lead can move it per quiz. It used
  // to default to 0, which quietly meant every candidate passed everything.
  passPercentage Decimal  @default(60) @db.Decimal(5, 2)
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  topic     Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  Attempt[]

  @@map("quizzes")
}

// Scoring rule: all-or-nothing. A question earns `marks` only if the selected
// options exactly match the correct set — every correct option ticked and no
// incorrect ones. Otherwise 0. No partial credit, no negative marking.
model Question {
  id        String       @id @default(uuid())
  quizId    String
  type      QuestionType @default(mcq_single)
  prompt    String
  marks     Int          @default(1)
  position  Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  quiz    Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuestionOption[]
  answers Answer[]

  @@unique([quizId, position])
  @@index([quizId])
  @@map("questions")
}

model QuestionOption {
  id         String  @id @default(uuid())
  questionId String
  label      String
  isCorrect  Boolean @default(false)
  position   Int

  question Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selected AnswerOption[]

  @@unique([questionId, position])
  @@index([questionId])
  @@map("question_options")
}

// ---------------------------------------------------------------- access

model Enrollment {
  id          String           @id @default(uuid())
  userId      String
  courseId    String
  // Defaults to active so a trainer allotting a topic enrolls outright; a
  // candidate subscribing to a course creates a pending row instead.
  status      EnrollmentStatus @default(active)
  enrolledAt  DateTime         @default(now())
  // Set the first time the candidate opens a topic in this course, and when
  // every quiz allotted to them has been attempted. Null until each happens.
  startedAt   DateTime?
  completedAt DateTime?

  /**
   * When this candidate is expected to finish.
   *
   * Stored rather than computed from startedAt + Course.durationWeeks, because
   * it moves: an approved extension pushes it out, and a pause pushes it out by
   * exactly the days lost. Recomputing it would throw both away.
   *
   * Null when the course has no duration set, which is a course with no
   * deadline rather than one that is instantly overdue.
   */
  dueAt DateTime?

  /**
   * Set while the candidate has paused — assigned to an urgent project, say.
   * Null means running. On resuming, the days between are added to both
   * pausedDays and dueAt, so a pause costs the candidate nothing.
   */
  pausedAt   DateTime?
  pausedDays Int       @default(0)

  /**
   * Set when the candidate moved off this edition onto a later one.
   *
   * The row stays rather than being deleted: the quizzes they sat and the marks
   * they earned happened on this version, and throwing the enrolment away would
   * orphan them. Superseded enrolments are filtered out of the candidate's own
   * lists and out of a lead's cohort, but the history is still there to read.
   */
  supersededAt DateTime?

  /**
   * Set when an administrator approves a request to leave.
   *
   * Like supersededAt, the row stays: somebody who stopped halfway still sat
   * the quizzes they sat, and the training record has to show what happened
   * rather than quietly losing the person. It is a third way an enrolment ends,
   * beside finishing it and moving to a later edition.
   */
  discontinuedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId, status])
  @@map("enrollments")
}

// A trainer explicitly releasing one topic (material + quiz) to one candidate.
model TopicAssignment {
  id         String   @id @default(uuid())
  userId     String
  topicId    String
  assignedBy String
  assignedAt DateTime @default(now())

  user    User  @relation("AssignedCandidate", fields: [userId], references: [id], onDelete: Cascade)
  topic   Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  trainer User  @relation("GrantedByTrainer", fields: [assignedBy], references: [id], onDelete: Restrict)

  @@unique([userId, topicId])
  @@index([topicId])
  @@map("topic_assignments")
}

/**
 * A candidate's opinion of a course — how useful the material was, how the
 * difficulty felt. One per candidate per course, editable afterwards, so this
 * stays a current view rather than a thread of comments.
 */
model CourseFeedback {
  id       String @id @default(uuid())
  userId   String
  courseId String
  // The overall verdict, and the two things it is usually made of. Split
  // because "3 stars" tells a lead nothing they can fix: a course marked down
  // for running too long needs a different change from one marked down for
  // thin material, and one number cannot say which.
  //
  // The halves are nullable and the overall is not: feedback left before this
  // split has only the overall, and asking those candidates to come back and
  // fill in the rest is not worth losing what they already said.
  rating         Int // 1-5, overall
  contentRating  Int? // 1-5, the material itself
  durationRating Int? // 1-5, whether the course was the right length
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("course_feedback")
}

/**
 * A candidate asking their course's lead for a one-to-one.
 *
 * Deliberately per course rather than per person: "I am stuck" is always stuck
 * on something, and routing it through the course is what tells the system
 * which lead is being asked. A candidate on three courses can have three open
 * requests, one with each lead.
 *
 * Only one may be open at a time per course — enforced in the service rather
 * than by a unique index, because resolved requests stay as a record and a
 * partial index over an enum is more machinery than the rule deserves.
 */
/**
 * A candidate asking for more time on a course.
 *
 * Approving one moves that candidate's Enrollment.dueAt and nobody else's —
 * which is the whole point of the deadline living on the enrolment rather than
 * being derived from the course.
 *
 * The days asked for are recorded separately from the days granted: a lead who
 * gives two weeks against a request for four has said something, and losing the
 * difference would make the record read as though the candidate got what they
 * asked for.
 */
/**
 * Something a candidate needs to know.
 *
 * Written when it happens rather than derived on read. "PM-101 v2 was published
 * on the 3rd" is a fact about that day; recomputing it from current state would
 * lose it as soon as v3 landed.
 *
 * `courseId` points at what the notice is *about* — for a new version, the new
 * edition, because that is where the action leads.
 */
model Notification {
  id     String     @id @default(uuid())
  userId String
  kind   NoticeKind
  title  String
  body   String?

  courseId  String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user   User    @relation("NotifiedUser", fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // The query behind the badge: one person's unread, newest first.
  @@index([userId, readAt])
  @@map("notifications")
}

/**
 * A candidate asking to stop a course.
 *
 * The reason is required and kept: the handbook wants discontinuance logged,
 * and the reasons are the useful part — a course people leave because they were
 * moved onto a project is a staffing problem, and one people leave because it
 * is too hard is a course problem. Those need telling apart.
 *
 * Approved by an administrator rather than the course's lead. A lead losing a
 * candidate has an interest in the answer, which is exactly why the decision
 * sits with somebody who does not.
 */
model DiscontinuationRequest {
  id       String            @id @default(uuid())
  courseId String
  userId   String
  status   DiscontinueStatus @default(requested)
  reason   String

  response    String?
  decidedById String?
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User   @relation("DiscontinueCandidate", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User?  @relation("DiscontinueDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([courseId, status])
  @@index([userId])
  @@map("discontinuation_requests")
}

model ExtensionRequest {
  id       String          @id @default(uuid())
  courseId String
  userId   String
  status   ExtensionStatus @default(requested)
  /**
   * The date the candidate wants to be given until, and why.
   *
   * A date rather than a number of days, because that is the shape of the
   * thought: somebody asks for time because of something with a date on it —
   * a release, a leave, a project ending — and making them convert that into
   * "eleven days" only to have the server convert it back invites off-by-one
   * arguments about which day they actually meant.
   */
  requestedUntil DateTime
  reason         String

  /**
   * What the lead actually gave. May be earlier than requested — a lead who
   * grants a fortnight against a request for a month has said something, and
   * storing only the outcome would make the record read as though the
   * candidate got what they asked for. Null on a decline.
   */
  grantedUntil DateTime?
  response     String?
  decidedById String?
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User   @relation("ExtensionCandidate", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User?  @relation("ExtensionDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([courseId, status])
  @@index([userId])
  @@map("extension_requests")
}

model SessionRequest {
  id       String        @id @default(uuid())
  courseId String
  userId   String
  status   SessionStatus @default(requested)
  // What the candidate wants to talk about. The whole value of the request:
  // a lead who knows the subject can prepare rather than spend the session
  // finding out why it was booked.
  reason String

  // Filled when the lead answers. `scheduledAt` is the agreed time;
  // `response` carries the joining details, or the reason for saying no.
  scheduledAt DateTime?
  response    String?
  decidedById String?
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User   @relation("SessionCandidate", fields: [userId], references: [id], onDelete: Cascade)
  // SetNull rather than Restrict: a lead can leave, and the record of what was
  // arranged outlives them.
  decidedBy User?  @relation("SessionDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([courseId, status])
  @@index([userId])
  @@map("session_requests")
}

// ---------------------------------------------------------------- submissions

// Retakes: every attempt is kept. The dashboard reports the LATEST attempt
// (highest attemptNumber with status = scored), not the best one.
model Attempt {
  id            String        @id @default(uuid())
  candidateId   String
  quizId        String
  attemptNumber Int // 1, 2, 3 ... per candidate per quiz
  status        AttemptStatus @default(in_progress)
  startedAt     DateTime      @default(now())
  submittedAt   DateTime?
  // Stored at submit time, never recomputed on page load.
  totalScore    Int           @default(0)
  maxScore      Int           @default(0)
  percentage    Decimal       @default(0) @db.Decimal(5, 2)

  candidate User     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers   Answer[]

  @@unique([candidateId, quizId, attemptNumber])
  @@index([candidateId, quizId])
  @@index([quizId])
  @@map("attempts")
}

model Answer {
  id           String       @id @default(uuid())
  attemptId    String
  questionId   String
  textResponse String? // written questions only
  awardedMarks Int          @default(0)
  isCorrect    Boolean      @default(false)
  status       AnswerStatus @default(submitted)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  attempt         Attempt        @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question        Question       @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedOptions AnswerOption[]

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@map("answers")
}

// Which options the candidate ticked. Multiple rows per Answer for mcq_multi.
model AnswerOption {
  answerId String
  optionId String

  answer Answer         @relation(fields: [answerId], references: [id], onDelete: Cascade)
  option QuestionOption @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@id([answerId, optionId])
  @@index([optionId])
  @@map("answer_options")
}
